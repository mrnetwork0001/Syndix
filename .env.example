# ------------------------------------------------------------------
# Syndix - copy to .env.local and fill in what you need.
# Every value is optional: with none set, the app runs in demo mode
# against the local dataset and a simulated agent pipeline.
# ------------------------------------------------------------------

# --- Deployed contracts -------------------------------------------
# Populate after `npm run contracts:deploy`. While these are unset the
# app reports its data source as "simulated" rather than "onchain".
NEXT_PUBLIC_SYNDIX_TREASURY=
NEXT_PUBLIC_SYNDIX_ARTICLE_NFT=

# --- x402 machine payments ----------------------------------------
# Where agents send per-request payment. Defaults to the treasury.
NEXT_PUBLIC_X402_PAY_TO=

# --- Deployment ---------------------------------------------------
# Used by script/Deploy.s.sol. Never commit a real key.
PRIVATE_KEY=
# Protocol owner. Prefer a Safe (predeployed on GIWA at genesis).
OWNER=
# Signs EIP-712 ReadProof attestations. Should be a dedicated hot key,
# separate from the owner, since it lives in the API process.
READ_ATTESTER=
# The matching private key, used by /api/attest to sign ReadProofs. Must
# correspond to the READ_ATTESTER address the treasury was deployed with, or
# every claim reverts with InvalidAttestation.
ATTESTER_PRIVATE_KEY=
# The live up.id / Dojang resolver. Leave blank on testnet to have the
# deploy script publish a MockUpIdRegistry stand-in.
READER_REGISTRY=

# Optional, for `forge verify-contract` against the GIWA explorer.
GIWA_EXPLORER_API_KEY=

# --- AI generation (OpenAI) ---------------------------------------
# With this set, /api/agent/run writes issues for real and the studio
# badge flips from "Simulated pipeline" to "Live - OpenAI".
OPENAI_API_KEY=
# Optional. Overrides the default model id in lib/openai.ts.
OPENAI_MODEL=

# --- IPFS pinning (Pinata) ----------------------------------------
# pinata.cloud -> API Keys -> New Key -> copy the JWT.
# Without this a generated issue is NOT publishable: the studio refuses
# to write a contentURI that points at nothing.
PINATA_JWT=

# --- ERC-4337 gasless claims --------------------------------------
# Deployed SyndixPaymaster address (after contracts:deploy:paymaster).
NEXT_PUBLIC_SYNDIX_PAYMASTER=
# Bundler RPC that relays UserOperations on GIWA Sepolia, e.g.
# https://api.pimlico.io/v2/91342/rpc?apikey=YOUR_KEY
NEXT_PUBLIC_BUNDLER_URL=

# ---------------------------------------------------------------------------
# Unattended publishing (the VPS cycle). See docs/VPS.md.
# ---------------------------------------------------------------------------

# The autonomy guard. SyndixTreasury is owned by this contract, so publishing
# runs through its caps rather than with the owner key.
NEXT_PUBLIC_SYNDIX_PUBLISHER=
# Revenue split: sponsor deposits land here, 80% committed to readers.
NEXT_PUBLIC_SYNDIX_SPONSORSHIP=

# Hot key for the publishing cycle. Holds the `publisher` role on
# SyndixPublisher and nothing else - it cannot withdraw, change caps, or take
# treasury ownership. This is the ONLY key that belongs on the server;
# PRIVATE_KEY (the treasury owner) must never be deployed there.
PUBLISHER_ADDRESS=
PUBLISHER_PRIVATE_KEY=

# Dedicated Pinata gateway, host only, e.g. "something.mypinata.cloud".
# Read path tries this first and falls back to ipfs.io.
PINATA_GATEWAY=

# Track the cycle writes for. Defaults to giwa-l2.
SYNDIX_TRACK=
