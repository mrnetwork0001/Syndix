# ------------------------------------------------------------------
# Syndix — copy to .env.local and fill in what you need.
# Every value is optional: with none set, the app runs in demo mode
# against the local dataset and a simulated agent pipeline.
# ------------------------------------------------------------------

# --- AI Agent Studio ----------------------------------------------
# With this set, /api/agent/run writes issues with claude-opus-5 for real.
# Without it, the studio replays the recorded pipeline and labels itself
# "Simulated" in the UI.
ANTHROPIC_API_KEY=

# --- Deployed contracts -------------------------------------------
# Populate after `npm run contracts:deploy`. While these are unset the
# app reports its data source as "simulated" rather than "onchain".
NEXT_PUBLIC_SYNDIX_TREASURY=
NEXT_PUBLIC_SYNDIX_ARTICLE_NFT=

# --- x402 machine payments ----------------------------------------
# Where agents send per-request payment. Defaults to the treasury.
NEXT_PUBLIC_X402_PAY_TO=

# --- Deployment ---------------------------------------------------
# Used by script/Deploy.s.sol. Never commit a real key.
PRIVATE_KEY=
# Protocol owner. Prefer a Safe (predeployed on GIWA at genesis).
OWNER=
# Signs EIP-712 ReadProof attestations. Should be a dedicated hot key,
# separate from the owner, since it lives in the API process.
READ_ATTESTER=
# The matching private key, used by /api/attest to sign ReadProofs. Must
# correspond to the READ_ATTESTER address the treasury was deployed with, or
# every claim reverts with InvalidAttestation.
ATTESTER_PRIVATE_KEY=
# The live up.id / Dojang resolver. Leave blank on testnet to have the
# deploy script publish a MockUpIdRegistry stand-in.
READER_REGISTRY=

# Optional, for `forge verify-contract` against the GIWA explorer.
GIWA_EXPLORER_API_KEY=
